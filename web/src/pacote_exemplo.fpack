{
  "formato": "fpack",
  "versao_formato": 1,
  "id": "tiago.lorentz",
  "nome": "Osciladores de Lorentz",
  "versao": "1.1.0",
  "autor": "Exemplo da Folha de Cálculo",
  "descricao": "Função dielétrica de Lorentz (um ou vários osciladores), índice complexo, absorção, refletância e soma de gaussianas para espectros.",
  "app_minimo": "0.8.0",
  "codigo": "// energia do fóton\nhc_eVnm := 1239.84198\nE_fot(λ) := hc_eVnm/λ\n// um oscilador: ε(E) = ε∞ + f·E0²/(E0² − E² − iγE)\nepsL(E, ε_inf, f, E0, γ) := ε_inf + f·E0^2/(E0^2 - E^2 - i·γ·E)\n// vários osciladores: P com linhas [f, E0, γ]\nepsLN(E, ε_inf, P) := prog\n  s ← ε_inf\n  for j ∈ 0 .. rows(P) - 1\n    s ← s + P[j,0]·P[j,1]^2/(P[j,1]^2 - E^2 - i·P[j,2]·E)\n  s\nend\n// índice complexo ñ = n + ik com k ≥ 0\nn_c(ε) := if(im(sqrt(ε)) < 0, -sqrt(ε), sqrt(ε))\nn_r(ε) := re(n_c(ε))\nk_e(ε) := im(n_c(ε))\nα_abs(ε, λ) := 4·π·k_e(ε)/λ\nR_norm(n_1, ε) := abs((n_1 - n_c(ε))/(n_1 + n_c(ε)))^2",
  "js": {
    "gaussSoma": {
      "args": [
        "x",
        "P"
      ],
      "corpo": "let s = 0;\nfor (const r of P) { const d = (x - r[1]) / r[2]; s += r[0] * Math.exp(-0.5 * d * d); }\nreturn s;",
      "python": "def gaussSoma(x, P):\n    P = np.atleast_2d(np.asarray(P, dtype=float))\n    x = np.asarray(x, dtype=float)[..., None]\n    return np.sum(P[:, 0] * np.exp(-0.5 * ((x - P[:, 1]) / P[:, 2])**2), axis=-1)",
      "matlab": "function s = gaussSoma(x, P)\n  s = zeros(size(x));\n  for j = 1:size(P, 1)\n    s = s + P(j,1)*exp(-0.5*((x - P(j,2))/P(j,3)).^2);\n  end\nend"
    }
  },
  "funcoes": [
    {
