  "teoria": [
    {
      "titulo": "Modelo de Lorentz",
      "texto": "Cada oscilador contribui com $$\\varepsilon(E)=\\varepsilon_\\infty+\\sum_j\\frac{f_j E_{0j}^2}{E_{0j}^2-E^2-i\\gamma_j E}$$ com convenção $e^{-i\\omega t}$, de modo que $\\mathrm{Im}\\,\\varepsilon>0$ indica absorção.\n\nO índice complexo é $\\tilde n=\\sqrt{\\varepsilon}=n+ik$, o coeficiente de absorção é $\\alpha=4\\pi k/\\lambda$ e a refletância normal é $R=|(n_1-\\tilde n)/(n_1+\\tilde n)|^2$.",
      "exemplo": "P_osc := [0.8, 2.5, 0.25; 0.3, 3.2, 0.4]\nε_t(E) := epsLN(E, 2.2, P_osc)\nn_r(ε_t(2.5)) =\nk_e(ε_t(2.5)) ="
    }
  ],
  "exemplo": [
    {
      "type": "math",
      "w": "third",
      "src": "P_osc := [0.8, 2.5, 0.25; 0.3, 3.2, 0.4]\nε_t(E) := epsLN(E, 2.2, P_osc)\nn_r(ε_t(2.5)) =\nk_e(ε_t(2.5)) ="
    },
    {
      "type": "xy",
      "w": "third",
      "xvar": "E",
      "xmin": "1.5",
      "xmax": "4",
      "npts": 300,
      "traces": [
        {
          "expr": "n_r(ε_t(E))",
          "name": "n",
          "color": "#1F5FAE",
          "width": 1.5,
          "dash": "solid",
          "marker": "none"
        },
        {
          "expr": "k_e(ε_t(E))",
          "name": "k",
          "color": "#B03A2E",
          "width": 1.5,
          "dash": "dash",
          "marker": "none"
        }
      ],
      "xlabel": "E (eV)",
      "ylabel": "n, k",
      "legend": "sup-dir",
      "preset": "acs1"
    }
  ],
